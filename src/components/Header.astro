---
import { SITE_TITLE } from '../consts';

const { pathname } = Astro.url;
const isActive = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
	<nav>
		<a class="site-title" href="/">{SITE_TITLE}</a>
		<div class="nav-links">
			<a href="/" aria-current={isActive('/') && pathname === '/' ? 'page' : undefined}>Home</a>
			<a href="/blog" aria-current={isActive('/blog') ? 'page' : undefined}>Blog</a>
			<a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
		</div>
	</nav>
</header>
